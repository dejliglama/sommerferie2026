rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Alle i familien logger anonymt ind (usynligt for brugeren) og må læse
    // alt i den fælles rejse, men kun skrive deres eget dokument (uid = deres eget id).
    // Undtagelsen: en spiller ved navn "Far" må også SLETTE andres dokumenter,
    // så familien kan nulstille spillerlisten hvis nødvendigt.
    match /trips/{tripId} {
      function isFar() {
        return exists(/databases/$(database)/documents/trips/$(tripId)/players/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/trips/$(tripId)/players/$(request.auth.uid)).data.name == 'Far';
      }

      match /players/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && (request.auth.uid == uid || isFar());
      }
      match /positions/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && (request.auth.uid == uid || isFar());
      }
      match /counters/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && (request.auth.uid == uid || isFar());
      }
    }
  }
}
